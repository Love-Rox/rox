  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/tests/unit/",
    "test:unit": "bun test src/tests/unit/",
    "test:integration": "bun test src/tests/integration/",
    "test:e2e": "bun test src/tests/e2e/",
    "test:all": "bun test",
    "test:sqlite": "bun test src/tests/integration/sqlite-repositories.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/bun": "^11.7.0",
    "@sentry/core": "11.7.0",
    "@simplewebauthn/server": "^14.0.3",
    "@simplewebauthn/types": "^12.0.0",
    "blurhash": "^2.0.5",
    "bullmq": "^6.3.14",
    "drizzle-orm": "^0.45.4",
    "eventsource": "^5.1.2",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "shared": "workspace:*",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/eventsource": "^3.0.0",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.5",
    "@types/sharp": "^0.32.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2"
  }
